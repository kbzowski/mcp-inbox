{
  "name": "@kbzowski/mcp-inbox",
  "version": "0.5.1",
  "description": "MCP server exposing IMAP/SMTP email over a fast local cache. Read, search, compose, and manage email from any IMAP provider with near-instant response times via background sync and IDLE push.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-inbox": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "anthropic",
    "email",
    "imap",
    "smtp",
    "mail",
    "inbox",
    "gmail",
    "outlook",
    "fastmail",
    "ai-tools",
    "llm-tools"
  ],
  "author": "Krzysztof Bzowski",
  "license": "MIT",
  "homepage": "https://github.com/kbzowski/mcp-inbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbzowski/mcp-inbox.git"
  },
  "bugs": {
    "url": "https://github.com/kbzowski/mcp-inbox/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests --type-aware",
    "lint:fix": "oxlint src tests --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:generate": "drizzle-kit generate",
    "prepare": "lefthook install",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "release": "changeset publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "1.0.0-beta.22",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1",
    "sqlite-vec": "0.1.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "1.0.0-beta.22",
    "esbuild": "^0.28.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
