# Required
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password-here
IMAP_HOST=imap.example.com

# IMAP connection
IMAP_PORT=993
IMAP_TLS=true
IMAP_TLS_REJECT_UNAUTHORIZED=true
IMAP_AUTH_TIMEOUT_MS=10000

# SMTP. Each falls back to its IMAP counterpart when unset.
# SMTP_HOST=smtp.example.com
# SMTP_USER=different-user@example.com
# SMTP_PASSWORD=different-password
SMTP_PORT=465
SMTP_SECURE=true

# Cache. Empty IMAP_CACHE_DIR means the platform cache dir:
#   Linux/macOS  $XDG_CACHE_HOME/mcp-inbox or ~/.cache/mcp-inbox
#   Windows      %LOCALAPPDATA%\mcp-inbox\Cache
IMAP_CACHE_DIR=
IMAP_CACHE_DEFAULT_STALENESS_SEC=60
IMAP_CACHE_BODY_RETAIN_DAYS=180

# Semantic search (optional). Leaving IMAP_EMBEDDINGS_BASE_URL empty disables
# imap_index_folder and imap_semantic_search; nothing else is affected. Any
# OpenAI-compatible /v1/embeddings endpoint works, including a local one.
# Indexing sends message subjects and senders to that endpoint.
IMAP_EMBEDDINGS_BASE_URL=
IMAP_EMBEDDINGS_API_KEY=
IMAP_EMBEDDINGS_MODEL=arctic-embed-l-v2
IMAP_EMBEDDINGS_DIMS=1024
IMAP_EMBEDDINGS_BATCH_SIZE=64
IMAP_EMBEDDINGS_TIMEOUT_MS=30000

# IDLE. Empty IMAP_IDLE_FOLDERS disables push.
IMAP_IDLE_ENABLED=true
IMAP_IDLE_FOLDERS=INBOX

# Debug namespaces, e.g. mcp-inbox:* or mcp-inbox:cache. Goes to stderr.
DEBUG=
